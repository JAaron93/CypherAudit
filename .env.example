# SignalChain Oracle (CypherAudit) Environment Configuration

# GCP BigQuery Settings
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=crypto_analytics_mart
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# BigQuery Hard Cost & Safety Guards
BIGQUERY_MAX_BYTES_BILLED=50000000 # 50 MB hard ceiling per query

# Gemini API Settings (for Natural Language Query Routing)
GEMINI_API_KEY=your-gemini-api-key

# ASI Agentverse & uAgents Settings
AGENT_SEED=your-secret-agent-seed-phrase-phrase-phrase
AGENT_NAME=signalchain-oracle
AGENTVERSE_MAILBOX_KEY=your-agentverse-mailbox-key # Optional for cloud mailbox

# Rate Limiting
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
